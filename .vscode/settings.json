{
    "C/C++ Include Guard.Comment Style": "Line",
    "C/C++ Include Guard.Macro Type": "Filename",
    "C/C++ Include Guard.Spaces After Endif": 2,
    "C/C++ Include Guard.Suffix": "_HPP",
    "cSpell.words": [
        "hotreload",
        "qameleon",
        "qmldir",
        "qresource"
    ],
    "editor.formatOnSave": true,
    "triggerTaskOnSave.tasks": {
        "Build & Install qameleon": [
            "/workspaces/QameleonGUI/libs/qameleon/src/hotreload/*",
            "/workspaces/QameleonGUI/libs/qameleon/src/controls/*",
            "/workspaces/QameleonGUI/libs/qameleon/src/controls/styles/*",
            "/workspaces/QameleonGUI/libs/qameleon/src/controls/styles/private/*",
            "/workspaces/QameleonGUI/libs/qameleon/src/controls/theming/*",
            "/workspaces/QameleonGUI/libs/qameleon/src/controls/typographies/*",
            "/workspaces/QameleonGUI/libs/qameleon/src/controls/typographies/scales/*",
        ],
    },
    "sonarlint.pathToCompileCommands": "${workspaceFolder}/build/compile_commands.json"
}